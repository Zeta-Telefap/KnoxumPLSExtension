<Window x:Class="BBPlusSimpleModder.Views.ModBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📥 Импорт мода / уровня" Width="740" Height="540" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="📦 Открыть DLL мода…" Click="OpenDll_Click"/>
            <Button Content="🗺 Открыть .lvl…" Click="OpenLvl_Click"/>
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7"
                       Text="DLL → увидите плагины и Harmony-патчи, декомпилируем в кирпичики"/>
        </StackPanel>

        <ListBox x:Name="FoundList" Grid.Row="1" Margin="0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Kind}" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ImportBtn" Content="⬇ Импортировать выбранное" Click="Import_Click" IsEnabled="False"/>
            <Button Content="Закрыть" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
