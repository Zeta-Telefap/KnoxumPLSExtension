<Window x:Class="BBPlusSimpleModder.Views.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Title="Ввод">
    <StackPanel Margin="12" Width="360">
        <TextBlock x:Name="PromptText" Text="Значение:" Margin="0,0,0,6"/>
        <TextBox x:Name="ValueBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" Click="Cancel_Click"/>
            <Button Content="OK" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
