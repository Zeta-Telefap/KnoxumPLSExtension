<UserControl x:Class="BBPlusSimpleModder.Views.Controls.LevelEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="4">
            <TextBlock Style="{StaticResource HeaderLabel}" Text="🗺 Уровень"/>
            <RadioButton x:Name="ToolHall" Content="⬜ Коридор" IsChecked="True" Margin="0,2"/>
            <RadioButton x:Name="ToolClass" Content="🏫 Класс" Margin="0,2"/>
            <RadioButton x:Name="ToolFaculty" Content="🚷 Faculty" Margin="0,2"/>
            <RadioButton x:Name="ToolOffice" Content="💼 Офис" Margin="0,2"/>
            <RadioButton x:Name="ToolErase" Content="⬜ Ластик" Margin="0,2"/>
            <Separator Margin="0,6"/>
            <RadioButton x:Name="ToolDoor" Content="🚪 Дверь" Margin="0,2"/>
            <RadioButton x:Name="ToolWindow" Content="🪟 Окно" Margin="0,2"/>
            <Separator Margin="0,6"/>
            <RadioButton x:Name="ToolNpc" Content="🧍 Спавн NPC" Margin="0,2"/>
            <RadioButton x:Name="ToolItem" Content="🥤 Спавн предмета" Margin="0,2"/>
            <RadioButton x:Name="ToolPoster" Content="🖼️ Постер" Margin="0,2"/>
            <Separator Margin="0,6"/>
            <Button Content="📂 Открыть .lvl" Click="OpenLvl_Click"/>
            <Button Content="💾 Сохранить .lvl" Click="SaveLvl_Click"/>
            <TextBlock x:Name="InfoText" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="LevelCanvas" Width="2400" Height="2400" Background="#F5F5F5"
                    MouseLeftButtonDown="Cell_MouseDown" MouseMove="Cell_MouseMove" MouseLeftButtonUp="Cell_MouseUp"/>
        </ScrollViewer>
    </Grid>
</UserControl>
